rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / COMMON HELPERS
    // ============================================================
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function now() {
      return request.time;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ============================================================
    // USERS
    // Keep the existing self-only model. The app stores appState here,
    // so we deliberately do not impose a narrow schema on appState.
    // ============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================================
    // DRIVER DIRECTORY
    // Public-to-signed-in driver directory; only the owner may mutate
    // their own directory entry.
    // ============================================================
    match /driver_directory/{driverId} {
      allow read: if signedIn();

      allow create: if isOwner(driverId)
        && hasOnly([
          'uid', 'displayName', 'photoURL', 'company', 'plate',
          'online', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 120
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.get('online', true) is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == now();

      allow update: if isOwner(driverId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'company', 'plate', 'online', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 120
        && request.resource.data.plate is string
        && request.resource.data.plate.size() <= 20
        && request.resource.data.get('online', true) is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == now();

      allow delete: if isOwner(driverId);
    }

    // ============================================================
    // POSTS
    // - Exact allow-list on create.
    // - createdAt must be server time.
    // - Author can edit only content/profile metadata for 30 minutes.
    // - Counters/likes cannot be changed by the author-edit path.
    // - Like and comment-counter transactions remain supported.
    // ============================================================
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && hasOnly([
          'authorId', 'authorName', 'authorPhoto', 'company', 'postType',
          'content', 'createdAt', 'likesCount', 'likedBy', 'commentsCount'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.authorPhoto is string
        && request.resource.data.authorPhoto.size() <= 2048
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() <= 120
        && request.resource.data.postType is string
        && request.resource.data.postType.size() > 0
        && request.resource.data.postType.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == now()
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentsCount == 0;

      allow update: if signedIn() && (

        // --------------------------------------------------------
        // A) AUTHOR EDIT: only within 30 minutes of createdAt.
        // Only content/profile classification may change.
        // updatedAt must be the server request time.
        // --------------------------------------------------------
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'authorName', 'authorPhoto', 'company', 'postType', 'content',
            'updatedAt'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.authorPhoto is string
          && request.resource.data.authorPhoto.size() <= 2048
          && request.resource.data.company is string
          && request.resource.data.company.size() > 0
          && request.resource.data.company.size() <= 120
          && request.resource.data.postType is string
          && request.resource.data.postType.size() > 0
          && request.resource.data.postType.size() <= 80
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == now()
          && resource.data.createdAt is timestamp
          && now() <= resource.data.createdAt + duration.value(30, 'm')
        )

        // --------------------------------------------------------
        // B) LIKE TOGGLE: exactly likedBy + likesCount.
        // --------------------------------------------------------
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount', 'likedBy'
          ])
          && request.resource.data.likedBy is list
          && request.resource.data.likesCount is int
          && request.resource.data.likesCount == request.resource.data.likedBy.size()
          && (
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.resource.data.likedBy.hasAny([request.auth.uid])
            )
            ||
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
              && resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && resource.data.likedBy.hasAny([request.auth.uid])
            )
          )
        )

        // --------------------------------------------------------
        // C) COMMENT COUNTER: exactly +1.
        // --------------------------------------------------------
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentsCount'
          ])
          && request.resource.data.commentsCount is int
          && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
          && request.resource.data.commentsCount >= 0
        )
      );

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // ----------------------------------------------------------
      // POST COMMENTS
      // ----------------------------------------------------------
      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorPhoto', 'content', 'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 120
          && request.resource.data.get('authorPhoto', '') is string
          && request.resource.data.get('authorPhoto', '').size() <= 2048
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == now();

        allow delete: if signedIn()
          && resource.data.authorId == request.auth.uid;

        allow update: if false;
      }
    }

    // ============================================================
    // COMMUNITY ROOMS
    // ============================================================
    match /community_rooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'updatedAt', 'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.get('updatedAt', now()) is timestamp
        && request.resource.data.get('updatedAt', now()) == now()
        && request.resource.data.get('lastMessage', '') is string
        && request.resource.data.get('lastMessage', '').size() <= 1000
        && request.resource.data.get('lastMessageAt', now()) is timestamp;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updatedAt', 'lastMessage', 'lastMessageAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || (request.resource.data.updatedAt is timestamp
                && request.resource.data.updatedAt == now()))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
            || (request.resource.data.lastMessageAt is timestamp
                && request.resource.data.lastMessageAt == now()))
        && request.resource.data.get('lastMessage', '') is string
        && request.resource.data.get('lastMessage', '').size() <= 1000;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderPhoto', 'content', 'createdAt', 'readBy'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.senderPhoto is string
          && request.resource.data.senderPhoto.size() <= 2048
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == now()
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= 2;

        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1
          && request.resource.data.readBy.size() <= 2;

        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ============================================================
    // DIRECT 1-1 CHATS
    // Only the two participant UIDs can read/write their conversation.
    // ============================================================
    match /direct_chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participantIds', 'participantProfiles', 'createdAt',
          'lastMessage', 'lastMessageAt', 'lastSenderId'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == now()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderId', 'participantProfiles'
        ])
        && request.resource.data.get('lastMessage', '') is string
        && request.resource.data.get('lastMessage', '').size() <= 160
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageAt'])
            || (request.resource.data.lastMessageAt is timestamp
                && request.resource.data.lastMessageAt == now()))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
            || request.resource.data.lastSenderId == request.auth.uid);

      allow delete: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/direct_chats/$(chatId)
          ).data.participantIds;

        allow create: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/direct_chats/$(chatId)
          ).data.participantIds
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderPhoto', 'content',
            'createdAt', 'readBy'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.senderPhoto is string
          && request.resource.data.senderPhoto.size() <= 2048
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == now()
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= 2;

        allow update: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/direct_chats/$(chatId)
          ).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= 2
          && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1;

        allow delete: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/direct_chats/$(chatId)
          ).data.participantIds
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
