rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /posts/{postId} {
      // Public community feed.
      allow read: if true;

      // Only a real signed-in driver may publish, and the authorId must be them.
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.company is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0;

      // Only the owner can edit/delete their post. A separate, tightly-scoped
      // update path allows only the likes fields to be changed by a signed-in
      // driver, with exactly one add/remove for that driver's uid.
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likesCount == request.resource.data.likedBy.size()
          && (
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.resource.data.likedBy.hasAny([request.auth.uid])
            )
            ||
            (
              request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
              && resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && resource.data.likedBy.hasAny([request.auth.uid])
            )
          )
        )
      );

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
