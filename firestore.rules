rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.company is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.likesCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentsCount == 0;
      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likesCount == request.resource.data.likedBy.size()
          && (
            (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.resource.data.likedBy.hasAny([request.auth.uid]))
            ||
            (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
              && resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && resource.data.likedBy.hasAny([request.auth.uid]))
          )
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
          && request.resource.data.commentsCount is int
          && request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
        )
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Nhóm chung: mọi tài xế đã xác thực đều có thể tham gia.
    match /community_rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAny([request.auth.uid]);
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Hội thoại cá nhân 1-1: chỉ hai UID trong participantIds có quyền truy cập.
    match /direct_chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderId', 'participantProfiles'
        ]);
      allow delete: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAny([request.auth.uid]);
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1;
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participantIds
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
